// J1: Parallel collect all host info (simulated locally)
print("=== J1: Parallel Collect ===")
let host = sys.hostname()
let mem = sys.memory.info()
let disk = sys.disk.usage("/")
let load = sys.load()
let ifaces = net.interfaces()
let ts = time.now()
print("Host: " + host.hostname)
print("Memory: " + str(mem.used_percent) + "%")
print("Disk: " + str(disk.used_percent) + "%")
print("Load: " + str(load.load1))
print("Interfaces: " + str(len(ifaces)))
print("Time: " + ts.iso8601)
report { scenario: "J1", status: "ok", mem: mem.used_percent, disk: disk.used_percent, load: load.load1, ifaces: len(ifaces) }
