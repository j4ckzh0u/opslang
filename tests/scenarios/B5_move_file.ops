// B5: Move/rename file
let test_dir = "/tmp/opslang-test-B5"
file.mkdir(test_dir)
file.write(test_dir + "/original.txt", "Move me\n")
let mv = file.move(test_dir + "/original.txt", test_dir + "/renamed.txt")
let ex_old = file.exists(test_dir + "/original.txt")
let ex_new = file.exists(test_dir + "/renamed.txt")
print("=== B5: Move File ===")
print("Moved: " + mv.src + " -> " + mv.dst)
print("Old gone: " + str(!ex_old.exists))
print("New exists: " + str(ex_new.exists))
file.delete(test_dir + "/renamed.txt")
process.exec("rmdir", test_dir)
report { scenario: "B5", status: "ok", old_gone: !ex_old.exists, new_exists: ex_new.exists }
