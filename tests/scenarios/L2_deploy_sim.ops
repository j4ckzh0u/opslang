// L2: Automated deployment simulation (check + backup + deploy + verify)
print("=== L2: Deployment Simulation ===")
let host = sys.hostname()
let ts = time.now()
let app = "testapp"
let ver = "1.0.0"
let base = "/tmp/opslang-test-deploy"

// Step 1: Pre-check
print("[1/5] Pre-check...")
let mem = sys.memory.info()
print("  Memory: " + str(mem.used_percent) + "%")

// Step 2: Create directory structure
print("[2/5] Creating dirs...")
file.mkdir(base)
file.mkdir(base + "/releases")
file.mkdir(base + "/config")
file.mkdir(base + "/current")

// Step 3: Backup existing (simulated)
print("[3/5] Backup...")
let backup_path = base + "/backup_" + str(ts.unix) + ".tar"
file.write(backup_path, "simulated backup data\n")
print("  Backup: " + backup_path)

// Step 4: Deploy
print("[4/5] Deploying...")
let app_path = base + "/current/" + app
file.write(app_path, "#!/bin/sh\necho " + app + " " + ver + "\n")
let config_path = base + "/config/app.conf"
file.write(config_path, "name=" + app + "\nversion=" + ver + "\n")
let cs_app = file.checksum(app_path, "sha256")
let cs_conf = file.checksum(config_path, "sha256")
print("  App checksum: " + cs_app.checksum)
print("  Config checksum: " + cs_conf.checksum)

// Step 5: Verify
print("[5/5] Verifying...")
let ex1 = file.exists(app_path)
let ex2 = file.exists(config_path)
let ex3 = file.exists(backup_path)
print("  App exists: " + str(ex1.exists))
print("  Config exists: " + str(ex2.exists))
print("  Backup exists: " + str(ex3.exists))

ensure file.exists(app_path).exists {
    print("  SHOULD NOT SEE - app already deployed")
}

// Cleanup - delete files first, then dirs
file.delete(app_path)
file.delete(config_path)
file.delete(backup_path)
file.delete(base + "/current")
file.delete(base + "/config")
file.delete(base + "/releases")
file.delete(base)

report {
    scenario: "L2",
    host: host.hostname,
    app: app,
    version: ver,
    app_checksum: cs_app.checksum,
    config_checksum: cs_conf.checksum,
    verified: ex1.exists && ex2.exists && ex3.exists,
    timestamp: ts.iso8601,
    status: "deployed_and_cleaned"
}
log("Deployment simulation completed")
