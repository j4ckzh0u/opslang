// B6: Delete file
let test_dir = "/tmp/opslang-test-B6"
file.mkdir(test_dir)
let p = test_dir + "/to_delete.txt"
file.write(p, "delete me\n")
let ex_before = file.exists(p)
file.delete(p)
let ex_after = file.exists(p)
print("=== B6: Delete File ===")
print("Before: " + str(ex_before.exists))
print("After: " + str(ex_after.exists))
process.exec("rmdir", test_dir)
report { scenario: "B6", status: "ok", existed_before: ex_before.exists, gone_after: !ex_after.exists }
