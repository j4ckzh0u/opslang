// L1: Complete system health check
print("=== L1: System Health Check ===")
let host = sys.hostname()
let mem = sys.memory.info()
let disk = sys.disk.usage("/")
let load = sys.load()
let up = sys.uptime()
let ts = time.now()

let mem_score = "healthy"
if mem.used_percent > 90 { mem_score = "critical" } else if mem.used_percent > 70 { mem_score = "warning" }

let disk_score = "healthy"
if disk.used_percent > 90 { disk_score = "critical" } else if disk.used_percent > 70 { disk_score = "warning" }

print("Host: " + host.hostname)
print("Memory: " + str(mem.used_percent) + "% [" + mem_score + "]")
print("Disk: " + str(disk.used_percent) + "% [" + disk_score + "]")
print("Load: " + str(load.load1) + " / " + str(load.load5) + " / " + str(load.load15))
print("Uptime: " + str(up.uptime) + "s")
print("Time: " + ts.iso8601)

metric("memory_usage", mem.used_percent, {"host": host.hostname})
metric("disk_usage", disk.used_percent, {"host": host.hostname})

report {
    scenario: "L1",
    host: host.hostname,
    memory: mem.used_percent,
    memory_status: mem_score,
    disk: disk.used_percent,
    disk_status: disk_score,
    load1: load.load1,
    uptime: up.uptime,
    timestamp: ts.iso8601,
    overall: "checked"
}
log("Health check completed")
