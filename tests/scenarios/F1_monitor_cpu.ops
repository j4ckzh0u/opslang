// F1: Monitor system metrics (3 samples - using load as CPU proxy since cpu.usage() not available on macOS)
print("=== F1: System Monitor ===")
let total = 0
for let i = 0; i < 3; i = i + 1 {
    let l = sys.load()
    print("  Sample " + str(i+1) + " load1m: " + str(l.load1))
    total = total + l.load1
}
let avg = total / 3
print("Average load: " + str(avg))
report { scenario: "F1", status: "ok", avg_load: avg, samples: 3 }
