// H2: Batch create test directories
print("=== H2: Batch Create Dirs ===")
let base = "/tmp/opslang-test-H"
let dirs = ["dir1", "dir2", "dir3", "dir4", "dir5"]
for let i = 0; i < len(dirs); i = i + 1 {
    file.mkdir(base + "/" + dirs[i])
    print("  Created: " + base + "/" + dirs[i])
}
// Verify
let listing = file.list(base)
print("Total dirs: " + str(len(listing.files)))
// Cleanup
for let i = 0; i < len(dirs); i = i + 1 {
    file.delete(base + "/" + dirs[i])
}
file.delete(base)
report { scenario: "H2", status: "ok", dirs_created: len(dirs) }
