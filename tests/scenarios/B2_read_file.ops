// B2: Read file content
let test_dir = "/tmp/opslang-test-B2"
file.mkdir(test_dir)
file.write(test_dir + "/test2.txt", "Read test content 12345\n")
let r = file.read(test_dir + "/test2.txt")
print("=== B2: Read File ===")
print("Content: " + r.content)
print("Size: " + str(r.size))
file.delete(test_dir + "/test2.txt")
process.exec("rmdir", test_dir)
report { scenario: "B2", status: "ok", size: r.size }
