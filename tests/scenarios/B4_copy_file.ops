// B4: Copy file
let test_dir = "/tmp/opslang-test-B4"
file.mkdir(test_dir)
file.write(test_dir + "/src.txt", "Copy source data\n")
let cp = file.copy(test_dir + "/src.txt", test_dir + "/dst.txt")
let cs1 = file.checksum(test_dir + "/src.txt", "sha256")
let cs2 = file.checksum(test_dir + "/dst.txt", "sha256")
print("=== B4: Copy File ===")
print("Src: " + cp.src + " -> Dst: " + cp.dst)
print("Checksum match: " + str(cs1.checksum == cs2.checksum))
file.delete(test_dir + "/src.txt")
file.delete(test_dir + "/dst.txt")
process.exec("rmdir", test_dir)
report { scenario: "B4", status: "ok", match: cs1.checksum == cs2.checksum }
