// F3: Disk IO (simulated via disk usage diff)
print("=== F3: Disk IO ===")
let d1 = sys.disk.usage("/")
print("First read - used: " + str(d1.used / 1073741824) + " GB")
// Write a small file to cause IO
file.write("/tmp/opslang_test_io.tmp", "io test data\n")
let d2 = sys.disk.usage("/")
print("After write - used: " + str(d2.used / 1073741824) + " GB")
let diff = d2.used - d1.used
print("Delta: " + str(diff) + " bytes")
file.delete("/tmp/opslang_test_io.tmp")
report { scenario: "F3", status: "ok", delta_bytes: diff }
