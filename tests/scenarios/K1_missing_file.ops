// K1: Access non-existent file (error handling via exists check)
print("=== K1: Missing File ===")
let check = file.exists("/tmp/opslang_nonexistent_file_xyz_12345.txt")
print("Exists: " + str(check.exists))
if check.exists {
    let r = file.read("/tmp/opslang_nonexistent_file_xyz_12345.txt")
    print("Read: " + r.content)
} else {
    print("File does not exist - handled gracefully")
}
report { scenario: "K1", status: "ok", file_exists: check.exists, error_handled: true }
