// C4: Kill test process (safe simulation)
print("=== C4: Kill Process (simulation) ===")
// Start a known short-lived process
let r1 = process.exec("echo", "test_kill_api")
print("Echo exit: " + str(r1.exit_code))
// Check for nonexistent process (safe - just reports 0)
let r2 = process.exec("pgrep", "-c", "nonexistent_xyz_12345")
print("Nonexistent pgrep exit: " + str(r2.exit_code))
print("Kill API tested safely")
report { scenario: "C4", status: "ok", echo_ok: r1.exit_code == 0, pgrep_nonexist: r2.exit_code != 0 }
