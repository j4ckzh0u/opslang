// 远程测试：获取系统信息
let hostname = sys.hostname()
let os_info = sys.os()
let cpu_info = sys.cpu.info()
let memory = sys.memory.info()
let disk = sys.disk.usage("/")
let load = sys.load()

report {
    hostname: hostname,
    os: os_info,
    cpu: cpu_info,
    memory: memory,
    disk: disk,
    load: load
}
