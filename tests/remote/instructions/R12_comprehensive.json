{
  "version": "1.0",
  "task_id": "R12_comprehensive",
  "dry_run": false,
  "instructions": [
    {"op": "sys.hostname", "args": {}, "assign": "host"},
    {"op": "sys.cpu.usage", "args": {}, "assign": "cpu"},
    {"op": "sys.memory.info", "args": {}, "assign": "mem"},
    {"op": "sys.disk.usage", "args": {"path": "/"}, "assign": "disk"},
    {"op": "sys.load.avg", "args": {}, "assign": "load"},
    {"op": "sys.uptime", "args": {}, "assign": "up"},
    {"op": "time.now", "args": {}, "assign": "ts"},
    {"op": "report", "args": {
      "hostname": "host",
      "cpu": "cpu",
      "memory": "mem",
      "disk": "disk",
      "load": "load",
      "uptime": "up",
      "timestamp": "ts"
    }}
  ]
}
