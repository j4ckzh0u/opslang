// test_runner.ops — 运维测试运行器
// 运行所有运维场景测试并汇总结果

print("╔══════════════════════════════════════════╗")
print("║      OpsLang 运维场景测试套件            ║")
print("╚══════════════════════════════════════════╝")
print()

tests = [
    "test/ops/test_connectivity.ops",
    "test/ops/test_disk_check.ops",
    "test/ops/test_cpu_load.ops",
    "test/ops/test_memory.ops",
    "test/ops/test_batch_exec.ops",
    "test/ops/test_fleet_parallel.ops",
    "test/ops/test_health_check.ops",
]

// 打印测试清单
print("测试清单:")
idx = 0
for t in tests
    idx = idx + 1
    print("  " + idx + ". " + t)
print()
print("使用以下命令逐个运行:")
for t in tests
    print("  ops run " + t)
print()
