// test_health_check.ops — 综合运维健康检查
// 一个脚本完成所有检查：连通性、磁盘、CPU、内存、网络、服务

config = json.parse(file.read("test/env/hosts.json"))
hosts = config["hosts"]

print("╔══════════════════════════════════════════╗")
print("║      OpsLang 综合运维健康检查            ║")
print("╚══════════════════════════════════════════╝")
print()

total_checks = 0
passed_checks = 0
failed_checks = 0

// ============================
// 1. SSH 连通性
// ============================
print("━━━ [1/5] SSH 连通性 ━━━")
for h in hosts
    total_checks = total_checks + 1
    result = ssh.run(h["ip"], "echo ok", h["user"], h["password"])
    if result["ok"]
        print("  ✓ " + h["name"] + " (" + h["ip"] + ")")
        passed_checks = passed_checks + 1
    else
        print("  ✗ " + h["name"] + " (" + h["ip"] + ") — 连接失败")
        failed_checks = failed_checks + 1
print()

// ============================
// 2. 系统信息
// ============================
print("━━━ [2/5] 系统信息 ━━━")
for h in hosts
    total_checks = total_checks + 1
    cmd = "hostname && cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"' && uname -r"
    result = ssh.run(h["ip"], cmd, h["user"], h["password"])
    if result["ok"]
        lines = strings.split(strings.trim(result["stdout"]), "\n")
        hostname = ""
        os_name = ""
        kernel = ""
        if lines.len() >= 1
            hostname = lines[0]
        if lines.len() >= 2
            os_name = lines[1]
        if lines.len() >= 3
            kernel = lines[2]
        print("  " + h["name"] + ":")
        print("    主机名: " + hostname)
        print("    系统:   " + os_name)
        print("    内核:   " + kernel)
        passed_checks = passed_checks + 1
    else
        print("  ✗ " + h["name"] + " — 获取失败")
        failed_checks = failed_checks + 1
print()

// ============================
// 3. CPU 和负载
// ============================
print("━━━ [3/5] CPU 和负载 ━━━")
for h in hosts
    total_checks = total_checks + 1
    cmd = "cat /proc/loadavg && nproc"
    result = ssh.run(h["ip"], cmd, h["user"], h["password"])
    if result["ok"]
        lines = strings.split(strings.trim(result["stdout"]), "\n")
        loadavg = ""
        cores = ""
        if lines.len() >= 1
            loadavg = lines[0]
        if lines.len() >= 2
            cores = lines[1]
        print("  " + h["name"] + ":")
        print("    负载: " + loadavg)
        print("    核心: " + cores)
        passed_checks = passed_checks + 1
    else
        print("  ✗ " + h["name"] + " — 获取失败")
        failed_checks = failed_checks + 1
print()

// ============================
// 4. 内存使用
// ============================
print("━━━ [4/5] 内存使用 ━━━")
for h in hosts
    total_checks = total_checks + 1
    cmd = "free -m | head -3"
    result = ssh.run(h["ip"], cmd, h["user"], h["password"])
    if result["ok"]
        mem_info = strings.trim(result["stdout"])
        print("  " + h["name"] + ":")
        lines = strings.split(mem_info, "\n")
        for line in lines
            print("    " + line)
        passed_checks = passed_checks + 1
    else
        print("  ✗ " + h["name"] + " — 获取失败")
        failed_checks = failed_checks + 1
print()

// ============================
// 5. 磁盘使用
// ============================
print("━━━ [5/5] 磁盘使用 ━━━")
for h in hosts
    total_checks = total_checks + 1
    cmd = "df -h --output=source,size,used,avail,pcent,target -x tmpfs -x devtmpfs -x squashfs 2>/dev/null | tail -n +2"
    result = ssh.run(h["ip"], cmd, h["user"], h["password"])
    if result["ok"]
        print("  " + h["name"] + ":")
        lines = strings.split(strings.trim(result["stdout"]), "\n")
        for line in lines
            if line.len() > 0
                print("    " + strings.trim(line))
        passed_checks = passed_checks + 1
    else
        print("  ✗ " + h["name"] + " — 获取失败")
        failed_checks = failed_checks + 1
print()

// ============================
// 汇总报告
// ============================
print("╔══════════════════════════════════════════╗")
print("║              检查汇总报告                ║")
print("╠══════════════════════════════════════════╣")
print("  总检查项: " + total_checks)
print("  通过:     " + passed_checks + " ✓")
print("  失败:     " + failed_checks + " ✗")
if failed_checks == 0
    print("  状态:     全部通过 ✓")
else
    print("  状态:     存在异常 ✗")
print("╚══════════════════════════════════════════╝")
