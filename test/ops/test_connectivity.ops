// test_connectivity.ops — SSH 连通性测试
// 测试所有主机的 SSH 连接是否正常

config = json.parse(file.read("test/env/hosts.json"))
hosts = config["hosts"]

print("=== SSH 连通性测试 ===")
print()

ok_count = 0
fail_count = 0

for h in hosts
    ip = h["ip"]
    user = h["user"]
    password = h["password"]
    name = h["name"]

    result = ssh.run(ip, "hostname", user, password)
    if result["ok"]
        hostname = strings.trim(result["stdout"])
        print("  ✓ " + name + " (" + ip + ") — " + hostname)
        ok_count = ok_count + 1
    else
        print("  ✗ " + name + " (" + ip + ") — 连接失败")
        fail_count = fail_count + 1

print()
print("结果: " + ok_count + " 成功, " + fail_count + " 失败")
if fail_count > 0
    print("状态: FAIL")
else
    print("状态: PASS ✓")
