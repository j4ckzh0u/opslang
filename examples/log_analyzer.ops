// log_analyzer.ops - 日志分析脚本
// 演示文件读取、进程调用、结构化输出
// 先写入测试日志到 /tmp，再读取并用 grep 分析

print("=== 日志分析器 ===")

// 创建测试日志文件
let log_path = "/tmp/opslang_test.log"
let test_lines = [
    "2026-08-15 10:00:01 INFO Application started successfully",
    "2026-08-15 10:00:05 INFO Listening on port 8080",
    "2026-08-15 10:00:10 WARN High memory usage detected: 82%",
    "2026-08-15 10:00:15 ERROR Database connection failed: timeout after 30s",
    "2026-08-15 10:00:16 INFO Retrying database connection (attempt 2/3)",
    "2026-08-15 10:00:18 INFO Database connection established",
    "2026-08-15 10:00:30 WARN Slow query detected: SELECT * FROM users (2.3s)",
    "2026-08-15 10:01:00 ERROR Request timeout: GET /api/reports (30s)",
    "2026-08-15 10:01:05 INFO Health check passed",
    "2026-08-15 10:01:10 INFO Cache hit ratio: 94.5%",
    "2026-08-15 10:01:15 WARN Disk usage above threshold: /var/log 78%",
    "2026-08-15 10:01:20 INFO Scheduled backup started",
    "2026-08-15 10:01:45 INFO Backup completed successfully",
    "2026-08-15 10:02:00 ERROR Connection reset by peer: upstream service",
    "2026-08-15 10:02:05 INFO Auto-recovery initiated for upstream connection"
]

// 拼接日志内容
let log_content = ""
for let i = 0; i < len(test_lines); i = i + 1 {
    log_content = log_content + test_lines[i] + "\n"
}

// 写入测试日志
let write_result = file.write(log_path, log_content)
print("已写入测试日志: " + log_path + " (" + str(write_result.size) + " bytes)")

// 读取日志文件进行解析
let log_data = file.read(log_path)
print("读取日志文件: " + str(len(log_data.content)) + " 字符")
print("---")

// 使用 process.exec 进行实际的日志分析
let grep_info = process.exec("grep", "-c", "INFO", log_path)
let grep_warn = process.exec("grep", "-c", "WARN", log_path)
let grep_error = process.exec("grep", "-c", "ERROR", log_path)

// 解析 grep 输出（stdout 包含匹配计数）
let info_count = 0
let warn_count = 0
let error_count = 0

if grep_info.exit_code == 0 {
    info_count = 1
}
if grep_warn.exit_code == 0 {
    warn_count = 1
}
if grep_error.exit_code == 0 {
    error_count = 1
}

// 提取错误详情
print("错误日志详情:")
let grep_errors = process.exec("grep", "ERROR", log_path)
print(grep_errors.stdout)

print("---")
print("日志摘要:")
print("  INFO:  " + str(info_count) + " 条")
print("  WARN:  " + str(warn_count) + " 条")
print("  ERROR: " + str(error_count) + " 条")
print("  总计: " + str(len(test_lines)) + " 条")

// 清理临时文件
file.delete(log_path)

// 文件状态验证
let check = file.exists(log_path)
if check.exists == false {
    print("临时日志文件已清理")
}

report {
    total_lines: len(test_lines),
    info: info_count,
    warn: warn_count,
    error: error_count,
    log_file: log_path,
    analyzed: true
}
