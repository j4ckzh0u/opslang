// cron_management.ops - 演示定时任务管理
// 新增 SDK: cron.*
privilege: admin

print("=== 查询定时任务 ===")

// 查询当前用户的定时任务（使用空字符串表示当前用户）
print("查询当前用户的定时任务...")
block {
    let current_crons = cron.list("")
    print("当前用户的定时任务数量: " + str(len(current_crons.entries)))
}
rescue {
    print("查询失败（可能没有 crontab）: " + _error)
    print("这是预期的，继续演示其他功能...")
}

// ═══════════════════════════════════════════════════════════
// 2. 添加定时任务（演示语法，不实际执行）
// ═══════════════════════════════════════════════════════════

print("\n=== 添加定时任务（演示） ===")
print("注意：实际添加需要适当的权限和环境")

// 演示 cron.add 的语法
print("示例命令：cron.add(\"\", \"0\", \"2\", \"*\", \"*\", \"*\", \"/usr/local/bin/backup.sh\", \"daily_backup\")")
print("这会添加一个每日 2:00 执行的备份任务")

print("\n=== cron 管理演示完成 ===")
