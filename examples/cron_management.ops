// cron_management.ops - 演示定时任务管理
// 新增 SDK: cron.*
privilege: admin

print("=== 查询定时任务 ===")

// 查询 root 用户的定时任务
print("查询 root 用户的定时任务...")
let root_crons = cron.list("root")
print("root 用户的定时任务数量: " + str(len(root_crons.entries)))

// ═══════════════════════════════════════════════════════════
// 2. 添加定时任务
// ═══════════════════════════════════════════════════════════

print("\n=== 添加定时任务 ===")

// 添加备份任务
print("添加每日备份任务...")
let backup_job = cron.add(
    "root",
    "0", "2", "*", "*", "*",
    "/usr/local/bin/backup.sh",
    "daily_backup"
)
print("  ✓ 备份任务已添加")

// 添加清理任务
print("\n添加每周清理任务...")
let cleanup_job = cron.add(
    "root",
    "0", "3", "*", "*", "0",
    "/usr/local/bin/cleanup.sh",
    "weekly_cleanup"
)
print("  ✓ 清理任务已添加")

// 添加健康检查任务（每 5 分钟）
print("\n添加健康检查任务（每 5 分钟）...")
let health_job = cron.add(
    "root",
    "*/5", "*", "*", "*", "*",
    "/usr/local/bin/health_check.sh",
    "health_check"
)
print("  ✓ 健康检查任务已添加")

// ═══════════════════════════════════════════════════════════
// 3. 批量添加任务
// ═══════════════════════════════════════════════════════════

print("\n=== 批量添加定时任务 ===")

let jobs = [
    {"name": "log_rotate", "minute": "0", "hour": "0", "command": "/usr/sbin/logrotate /etc/logrotate.conf"},
    {"name": "metrics_collect", "minute": "*/10", "hour": "*", "command": "/usr/local/bin/collect_metrics.sh"},
    {"name": "report_send", "minute": "0", "hour": "8", "command": "/usr/local/bin/send_report.sh"}
]

for job in jobs {
    let result = cron.add(
        "root",
        job["minute"], job["hour"], "*", "*", "*",
        job["command"],
        job["name"]
    )
    print("  ✓ " + job["name"] + " 已添加")
}

// ═══════════════════════════════════════════════════════════
// 4. 验证任务
// ═══════════════════════════════════════════════════════════

print("\n=== 验证定时任务 ===")

let final_check = cron.list("root")
print("当前定时任务总数: " + str(len(final_check.entries)))

// ═══════════════════════════════════════════════════════════
// 5. 删除定时任务
// ═══════════════════════════════════════════════════════════

print("\n=== 清理定时任务 ===")

// 删除特定任务
cron.remove("root", "daily_backup")
print("  ✓ 已删除: daily_backup")

cron.remove("root", "weekly_cleanup")
print("  ✓ 已删除: weekly_cleanup")

// 批量删除
let jobs_to_remove = ["health_check", "log_rotate", "metrics_collect", "report_send"]
for name in jobs_to_remove {
    cron.remove("root", name)
    print("  ✓ 已删除: " + name)
}

print("\n=== cron 管理演示完成 ===")
