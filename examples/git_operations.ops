// git_operations.ops - 演示 Git 操作
// 新增 SDK: git.*
privilege: admin

print("=== 克隆 Git 仓库 ===")

let repo_url = "https://github.com/j4ckzh0u/opslang.git"
let clone_dir = "/tmp/opslang-clone-test"

// 清理可能存在的目录
file.delete(clone_dir)

// 克隆仓库
print("克隆仓库: " + repo_url)
let clone_result = git.clone(repo_url, clone_dir, {})
print("  ✓ 克隆成功")
print("  路径: " + clone_result.path)
print("  分支: " + clone_result.branch)

// 克隆特定分支
print("\n克隆特定分支 (main)...")
let clone_branch_dir = "/tmp/opslang-main-test"
file.delete(clone_branch_dir)

let clone_branch = git.clone(repo_url, clone_branch_dir, {
    "branch": "main",
    "depth": "1"  // 浅克隆，节省空间
})
print("  ✓ 克隆成功")
print("  分支: " + clone_branch.branch)

// ═══════════════════════════════════════════════════════════
// 2. 拉取更新
// ═══════════════════════════════════════════════════════════

print("\n=== 拉取更新 ===")

// 拉取默认分支
print("拉取最新更新...")
let pull_result = git.pull(clone_dir, "", "")
if pull_result.changed {
    print("  ✓ 已更新到新提交")
    print("  提交: " + pull_result.commit)
} else {
    print("  - 已是最新")
}

// ═══════════════════════════════════════════════════════════
// 3. 实际场景：部署应用
// ═══════════════════════════════════════════════════════════

print("\n=== 实际场景：从 Git 部署应用 ===")

let app_repo = "https://github.com/j4ckzh0u/opslang.git"
let app_dir = "/tmp/app-deploy-test"

// 步骤 1: 清理旧版本
print("步骤 1: 清理旧版本...")
file.delete(app_dir)
print("  ✓ 旧版本已清理")

// 步骤 2: 克隆新版本
print("\n步骤 2: 克隆新版本...")
let deploy_clone = git.clone(app_repo, app_dir, {
    "branch": "main"
})
print("  ✓ 代码已克隆")

// 步骤 3: 验证代码
print("\n步骤 3: 验证代码...")
let readme = file.read(app_dir + "/README.md")
print("  ✓ README.md 存在")
print("  大小: " + str(len(readme.content)) + " 字节")

// 步骤 4: 列出文件
print("\n步骤 4: 列出仓库文件...")
let files = file.list(app_dir)
print("  文件数量: " + str(len(files.files)))
let count = 0
for f in files.files {
    if count >= 5 {
        break
    }
    print("    - " + f.name)
    count = count + 1
}

// ═══════════════════════════════════════════════════════════
// 4. 清理测试数据
// ═══════════════════════════════════════════════════════════

print("\n=== 清理测试数据 ===")

let dirs_to_clean = [clone_dir, clone_branch_dir, app_dir]
for dir in dirs_to_clean {
    file.delete(dir)
    print("  ✓ 删除: " + dir)
}

print("\n=== git 操作演示完成 ===")
