// git_operations.ops - 演示 Git 操作
// 新增 SDK: git.*
privilege: admin

print("=== Git 操作演示 ===")
print("注意：此示例需要 git 命令行工具")

// ═══════════════════════════════════════════════════════════
// 1. 克隆仓库（演示用法）
// ═══════════════════════════════════════════════════════════

print("\n1. 克隆仓库示例:")
print("   代码: git.clone(\"https://github.com/user/repo.git\", \"/tmp/repo\", {})")

// 实际执行（可能失败，取决于网络和环境）
block {
    let test_dir = "/tmp/git-demo-clone"
    process.exec("rm", ["-rf", test_dir])

    // 尝试克隆一个小型公开仓库
    let result = git.clone("https://github.com/octocat/Hello-World.git", test_dir, {
        "depth": "1"
    })
    print("   ✓ 克隆成功")
    print("   路径: " + result.path)
    print("   有变更: " + str(result.changed))

    // 清理
    process.exec("rm", ["-rf", test_dir])
    print("   ✓ 已清理")
}
rescue {
    print("   ✗ 克隆失败（可能无网络或 git 未安装）: " + _error)
}

// ═══════════════════════════════════════════════════════════
// 2. 拉取更新（演示用法）
// ═══════════════════════════════════════════════════════════

print("\n2. 拉取更新示例:")
print("   代码: git.pull(\"/path/to/repo\", \"origin\", \"main\")")
print("   返回: {changed: bool, commit: string, error: string}")

// ═══════════════════════════════════════════════════════════
// 3. 实际场景：Git 部署流程
// ═══════════════════════════════════════════════════════════

print("\n3. Git 部署流程示例:")
print(`
   // 部署脚本示例
   let repo = "https://github.com/myorg/myapp.git"
   let deploy_dir = "/opt/myapp"
   let backup_dir = "/opt/myapp-backup-" + str(time.now().unix)

   // 备份当前版本
   block {
       file.copy(deploy_dir, backup_dir)
       print("备份完成")
   }
   rescue {
       print("备份失败: " + _error)
   }

   // 克隆新版本
   block {
       process.exec("rm", ["-rf", deploy_dir])
       let clone = git.clone(repo, deploy_dir, {"branch": "main"})
       print("代码已更新")

       // 重启服务
       service.restart("myapp")
       print("服务已重启")
   }
   rescue {
       print("部署失败: " + _error)
       // 回滚
       file.copy(backup_dir, deploy_dir)
       service.restart("myapp")
       print("已回滚到上一版本")
   }
`)

// ═══════════════════════════════════════════════════════════
// 4. Git 操作最佳实践
// ═══════════════════════════════════════════════════════════

print("\n4. Git 操作最佳实践:")
print(`
   ✓ 使用 depth: "1" 进行浅克隆，节省空间和时间
   ✓ 指定 branch 参数避免克隆所有分支
   ✓ 部署前备份当前版本
   ✓ 使用 block/rescue 处理失败并回滚
   ✓ 清理临时克隆目录
   ✓ 生产环境使用特定 tag 或 commit，而非 branch
`)

print("\n=== Git 操作演示完成 ===")
