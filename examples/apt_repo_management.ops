// apt_repo_management.ops - 演示 APT 仓库管理
// 新增 SDK: apt_repo.*
privilege: admin

print("=== APT 仓库管理 ===")

// 1. 列出当前仓库
print("\n当前 APT 仓库:")
block {
    let repos = apt_repo.list()
    if len(repos.repos) == 0 {
        print("  (无 APT 仓库配置 - 可能在非 Debian/Ubuntu 系统上)")
    } else {
        for repo in repos.repos {
            let status = "禁用"
            if repo.enabled {
                status = "启用"
            }
            print("  [" + status + "] " + repo.type + " " + repo.uri + " " + repo.dist + " " + repo.comps)
        }
    }
}
rescue {
    print("  ✗ 无法读取 APT 仓库配置（需要 Linux 系统）")
}

// 2. 检查仓库是否存在
print("\n检查仓库是否存在:")
block {
    let exists = apt_repo.exists("archive.ubuntu.com")
    if exists.exists {
        print("  ✓ Ubuntu 官方仓库已配置")
    } else {
        print("  ✗ Ubuntu 官方仓库未配置")
    }
}
rescue {
    print("  ✗ 无法检查仓库（需要 Linux 系统）")
}

// 3. 变更操作说明（本示例不执行变更，也不假装执行）
print("\n变更操作（本示例不执行 — 会真实修改 /etc/apt/sources.list.d/）:")
print("  apt_repo.add(uri, dist, components)   真实写入软件源配置")
print("  apt_repo.update()                     真实执行 apt-get update")
print("  apt_repo.remove(uri)                  真实移除软件源")
print("\n执行前提: Linux + apt + root。用法与返回值详见 docs/stdlib-reference.md")

print("\n=== apt_repo 管理演示完成 ===")
