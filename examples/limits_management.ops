// limits_management.ops - 演示系统资源限制管理
// 新增 SDK: limits.*
privilege: admin

print("=== 系统资源限制管理 ===")

// 1. 列出当前限制
print("\n当前 limits.conf 配置:")
block {
    let entries = limits.list()
    if len(entries.entries) == 0 {
        print("  (无自定义限制配置)")
    } else {
        let count = 0
        let total = len(entries.entries)
        let i = 0
        while i < total && count < 10 {
            let e = entries.entries[i]
            print("  " + e.domain + "\t" + e.type + "\t" + e.item + "\t" + e.value)
            count = count + 1
            i = i + 1
        }
        if total > 10 {
            print("  ... 共 " + str(total) + " 条配置")
        }
    }
}
rescue {
    print("  ✗ 无法读取 limits.conf（需要 Linux 系统）")
}

// 2. 获取特定用户/组的限制
print("\nroot 用户的限制:")
block {
    let root_limits = limits.get("root")
    if len(root_limits.entries) == 0 {
        print("  (无自定义限制)")
    } else {
        for e in root_limits.entries {
            print("  " + e.type + "\t" + e.item + "\t" + e.value)
        }
    }
}
rescue {
    print("  ✗ 无法获取 root 限制")
}

// 3. 真实设置/移除限制（需要 Linux + root，写入 /etc/security/limits.conf
//    使用专用演示域，结束后完全清理）
print("\n真实写入演示（limits.conf 域 opslang-demo-user，结束后清理）:")
let can_write = false
block {
    // /run 仅 root 可写：探测真实写权限
    file.ensure("/run/opslang-root-probe", "touch", "")
    file.ensure("/run/opslang-root-probe", "absent", "")
    can_write = true
}
rescue {
    print("  SKIP: 写入 limits.conf 需要 root — " + _error)
}

if can_write {
    block {
        let s1 = limits.set("opslang-demo-user", "soft", "nofile", "65535")
        let s2 = limits.set("opslang-demo-user", "hard", "nofile", "65535")
        print("  set soft/hard nofile: changed=" + str(s1.changed) + "/" + str(s2.changed))

        // 从 limits.conf 读回验证（真实读取）
        let got = limits.get("opslang-demo-user")
        print("  读回验证: " + str(len(got.entries)) + " 条记录")

        // 清理演示域，不留下任何残留
        let rm = limits.remove("opslang-demo-user")
        print("  remove: changed=" + str(rm.changed))

        let after = limits.get("opslang-demo-user")
        if len(after.entries) != 0 {
            alert("limits.remove 后仍有残留记录")
        }
    }
    rescue {
        // 即使中途失败也尝试清理
        block { limits.remove("opslang-demo-user") }
        rescue { }
        print("  ✗ 操作失败: " + _error)
    }
}

print("\n=== limits 管理演示完成 ===")
