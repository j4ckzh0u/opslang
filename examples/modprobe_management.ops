// modprobe_management.ops - Linux kernel module management
block {
    let modules = modprobe.list()
    report { loaded_modules: modules }

    let is_loaded = modprobe.is_loaded("loop")
    report { loop_loaded: is_loaded }

    // Ensure ip_vs module loads at boot (requires root)
    block {
        let boot_result = modprobe.set_boot("ip_vs", true)
        report { boot_persist: boot_result }
    }
    rescue {
        print("set_boot requires root: " + _error)
    }
}
rescue {
    print("modprobe not available: " + _error)
}
