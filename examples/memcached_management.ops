// Memcached 缓存管理示例
// Memcached cache management example

// 获取 Memcached 版本
block {
    let result = memcached.version("127.0.0.1", 11211)
    report {
        version: result.version
    }
}
rescue {
    print("memcached.version failed: " + _error)
}

// 获取统计信息
block {
    let stats = memcached.stats("127.0.0.1", 11211)
    report {
        version: stats.version,
        curr_items: stats.curr_items,
        curr_connections: stats.curr_connections,
        total_items: stats.total_items,
        get_hits: stats.get_hits,
        get_misses: stats.get_misses,
        uptime: stats.uptime
    }
}
rescue {
    print("memcached.stats failed: " + _error)
}

// 设置缓存值
block {
    let result = memcached.set("session:user123", "token_abc_xyz", "127.0.0.1", 11211, 3600)
    report {
        key: result.key,
        success: result.success,
        stored: result.stored
    }
}
rescue {
    print("memcached.set failed: " + _error)
}

// 获取缓存值
block {
    let result = memcached.get("session:user123", "127.0.0.1", 11211)
    report {
        key: result.key,
        found: result.found,
        value: result.value
    }
}
rescue {
    print("memcached.get failed: " + _error)
}

// 删除缓存值
block {
    let result = memcached.delete("session:user123", "127.0.0.1", 11211)
    report {
        key: result.key,
        success: result.success,
        deleted: result.deleted
    }
}
rescue {
    print("memcached.delete failed: " + _error)
}

// 清空所有缓存
block {
    let result = memcached.flush_all("127.0.0.1", 11211)
    report {
        success: result.success
    }
}
rescue {
    print("memcached.flush_all failed: " + _error)
}
