// mount_management.ops - 演示挂载点管理
// 新增 SDK: mount.*
privilege: admin

print("=== 挂载点管理 ===")

// 1. 列出当前挂载点
print("\n当前挂载点（前 10 个）:")
block {
    let mounts = mount.list()
    let count = 0
    let total = len(mounts.mounts)
    while count < total && count < 10 {
        let m = mounts.mounts[count]
        print("  " + m.device + " -> " + m.mount_point + " (" + m.fs_type + ")")
        count = count + 1
    }
    if total > 10 {
        print("  ... 共 " + str(total) + " 个挂载点")
    }
}
rescue {
    print("  ✗ 无法列出挂载点")
}

// 2. 查看 /etc/fstab
print("\n/etc/fstab 条目:")
block {
    let fstab = mount.fstab()
    if len(fstab.entries) == 0 {
        print("  (无条目)")
    } else {
        for e in fstab.entries {
            print("  " + e.device + " -> " + e.mount_point + " (" + e.fs_type + ")")
        }
    }
}
rescue {
    print("  ✗ 无法读取 /etc/fstab")
}

// 3. 变更操作说明（挂载影响存储布局，本示例不执行，也不假装执行）
print("\n变更操作（本示例不执行 — 会真实挂载/卸载/改写 fstab）:")
print("  mount.mount(dev, dir, fs, opts)        真实挂载（写入 /etc/mtab）")
print("  mount.umount(dir)                      真实卸载")
print("  mount.add_fstab(...) / remove_fstab    真实增删 /etc/fstab 条目")
print("\n挂载操作需要 root 权限；错误参数可能导致启动异常，请核对设备名。")
print("用法与返回值详见 docs/stdlib-reference.md")

print("\n注意：挂载操作需要 root 权限")

print("\n=== mount 管理演示完成 ===")
