// 批量文件操作示例
// 演示批量创建目录、写入文件、列出目录、计算校验和、清理

privilege: admin
print("=== 批量文件操作 ===")

// 基础目录
let base_dir = "/tmp/opslang_batch_test"

// 第一步：创建目录结构
let subdirs = ["logs", "data", "config", "reports"]
let created_dirs = []

for let i = 0; i < len(subdirs); i = i + 1 {
    let dir_path = base_dir + "/" + subdirs[i]
    file.mkdir(dir_path)
    created_dirs = created_dirs + [dir_path]
    print("创建目录: " + dir_path)
}

// 第二步：在每个子目录中写入文件
for let i = 0; i < len(subdirs); i = i + 1 {
    let file_path = base_dir + "/" + subdirs[i] + "/output.txt"
    let content = "Directory: " + subdirs[i] + "\nGenerated by OpsLang batch_file_ops\n"
    let result = file.write(file_path, content)
    print("写入文件: " + file_path + " (" + str(result.size) + " bytes)")
}

// 第三步：列出基础目录内容
let listing = file.list(base_dir)
print("---")
print("目录列表 (" + base_dir + "):")
for let i = 0; i < len(listing.files); i = i + 1 {
    let entry = listing.files[i]
    print("  " + entry.name + " (dir: " + str(entry.is_dir) + ", size: " + str(entry.size) + ")")
}

// 第四步：计算所有文件的校验和
print("---")
print("文件校验和:")
for let i = 0; i < len(subdirs); i = i + 1 {
    let file_path = base_dir + "/" + subdirs[i] + "/output.txt"
    let cs = file.checksum(file_path, "sha256")
    print("  " + file_path + " -> " + cs.checksum)
}

// 第五步：验证文件存在性
print("---")
print("文件验证:")
for let i = 0; i < len(subdirs); i = i + 1 {
    let file_path = base_dir + "/" + subdirs[i] + "/output.txt"
    let check = file.exists(file_path)
    let stat = file.stat(file_path)
    print("  " + stat.name + ": exists=" + str(check.exists) + ", size=" + str(stat.size) + ", mode=" + stat.mode)
}

// 第六步：复制一个文件作为备份
let backup_path = base_dir + "/backup_output.txt"
let copy_result = file.copy(base_dir + "/logs/output.txt", backup_path)
print("---")
print("备份文件: " + copy_result.src + " -> " + copy_result.dst + " (" + str(copy_result.size) + " bytes)")

// 第七步：清理所有文件
print("---")
print("清理临时文件...")
for let i = 0; i < len(subdirs); i = i + 1 {
    let file_path = base_dir + "/" + subdirs[i] + "/output.txt"
    file.delete(file_path)
}
file.delete(backup_path)

// 验证清理
let final_check = file.exists(base_dir + "/logs/output.txt")
if final_check.exists == false {
    print("清理完成，文件已删除")
}

report {
    total_dirs: len(subdirs),
    total_files: len(subdirs),
    dirs_created: created_dirs,
    operations: ["mkdir", "write", "list", "checksum", "stat", "copy", "delete"],
    status: "completed"
}
