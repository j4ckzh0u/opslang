// Ruby Gem 包管理示例
// Ruby gem package management example

// 获取 gem 版本
block {
    let ver = gem.version()
    report {
        version: ver.version
    }
}
rescue {
    print("gem.version failed (ruby may not be installed): " + _error)
}

// 列出已安装的 gem（真实调用本机 gem，返回状态与原始输出）
block {
    let gems = gem.list()
    report {
        status: gems.status,
        output_preview: gems.output
    }
}
rescue {
    print("gem.list failed: " + _error)
}

// 查询 gem 信息（本地 specification 查询，未安装则真实报错）
block {
    let info = gem.info("bundler")
    report {
        name: info.package,
        status: info.status
    }
}
rescue {
    print("gem.info failed: " + _error)
}

// 变更操作说明：gem.install 是真实安装（写用户的 gem 目录并联网下载），
// 示例不应该改动物理机的 ruby 环境，因此这里不执行、也不假装执行。
// 用法: gem.install(name, version, force) —— 详见 docs/stdlib-reference.md
