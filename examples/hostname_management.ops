// hostname_management.ops - 演示主机名管理
// 新增 SDK: hostname.*
privilege: admin

print("=== 主机名管理 ===")

// 1. 获取当前主机名
print("\n当前主机名:")
block {
    let info = hostname.get()
    print("  主机名: " + info.hostname)
    print("  FQDN: " + info.fqdn)
}
rescue {
    print("  ✗ 无法获取主机名")
}

// 2. 变更操作说明（改主机名影响面大，本示例不执行，也不假装执行）
print("\n变更操作（本示例不执行 — 会真实修改 /etc/hostname 与 /etc/hosts）:")
print("  hostname.set(host)        设置主机名（立即生效）")
print("  hostname.set_fqdn(fqdn)   设置 FQDN")
print("\n执行前提: Linux + root。改动主机名会影响集群身份识别，")
print("请确认影响面后再执行。用法详见 docs/stdlib-reference.md")

print("\n注意：")
print("  - 设置主机名需要 root 权限")
print("  - 修改后会立即生效")
print("  - 同时更新 /etc/hostname 和 /etc/hosts")

print("\n=== hostname 管理演示完成 ===")
