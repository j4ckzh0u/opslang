// wait_for_service.ops - 演示 net.wait_for 操作
// 等待端口可达，常用于服务启动后等待
privilege: read_only

print("=== 等待端口演示 ===")

// 短超时快速检查（不阻塞）
print("检查端口 22 (1s 超时)...")
let wait_ssh = net.wait_for("127.0.0.1", 22, 1)
if wait_ssh.success {
    print("  ✓ SSH 端口已开放")
} else {
    print("  ✗ SSH 端口未开放")
}

print("检查端口 9999 (1s 超时)...")
let quick_check = net.wait_for("127.0.0.1", 9999, 1)
if quick_check.success {
    print("  ✓ 端口开放")
} else {
    print("  ✗ 端口未开放（预期）")
}

print("\n=== net.wait_for 演示完成 ===")
