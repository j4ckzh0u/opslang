// fleet_demo.ops - 批量执行引擎演示

// 定义服务器清单
inventory = {
    web_servers: ["10.0.0.1", "10.0.0.2", "10.0.0.3"],
    db_servers: ["10.0.1.1", "10.0.1.2"],
    cache_servers: ["10.0.2.1"],
}

// ============================================
// 示例 1: 批量执行命令
// ============================================
print("=== 批量执行 uptime ===")

results = fleet.exec(
    hosts = inventory.web_servers,
    command = "uptime",
    parallel = 10,
    timeout = "30s",
)

for r in results {
    print("{r.host}: {r.stdout}")
}

// ============================================
// 示例 2: 滚动更新
// ============================================
print("")
print("=== 滚动更新 Nginx ===")

fleet.rolling_update(
    hosts = inventory.web_servers,
    batch_size = 1,          // 每次更新 1 台
    delay = "30s",            // 每批间隔 30 秒
    task = fn(host) {
        print("更新 {host} ...")
        ssh.run(host, "yum update nginx -y")
        ssh.run(host, "systemctl restart nginx")

        // 健康检查
        health = http.get("http://{host}/health")
        if health.status != 200 {
            print("健康检查失败，回滚 {host}")
            ssh.run(host, "yum downgrade nginx -y")
            return false
        }
        return true
    },
)

// ============================================
// 示例 3: 批量健康检查
// ============================================
print("")
print("=== 批量健康检查 ===")

all_hosts = inventory.web_servers + inventory.db_servers + inventory.cache_servers

health_results = fleet.health_check(
    hosts = all_hosts,
    checks = [
        check.ssh(),                    // SSH 连通性
        check.disk(max=80),             // 磁盘使用率 < 80%
        check.memory(max=85),           // 内存使用率 < 85%
        check.load(max=5),              // 负载 < 5
    ],
)

// 汇总
health_results.summary()

// 失败的自动告警
if health_results.has_failures() {
    health_results.notify(
        channels = ["wechat:ops-group", "email:ops@company.com"],
        template = "health_check_alert",
    )
}

// ============================================
// 示例 4: 配置分发
// ============================================
print("")
print("=== 分发配置文件 ===")

fleet.distribute(
    hosts = inventory.web_servers,
    files = [
        {src: "./config/nginx.conf", dst: "/etc/nginx/nginx.conf"},
        {src: "./config/logrotate.conf", dst: "/etc/logrotate.d/nginx"},
    ],
    backup = true,           // 备份原文件
    on_change = fn(host, path) {
        print("配置已更新: {host}:{path}")
        ssh.run(host, "nginx -t && nginx -s reload")
    },
)
