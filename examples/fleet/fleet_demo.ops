// fleet_demo.ops - Fleet 批量执行引擎演示

print("=== Fleet 批量执行引擎演示 ===")
print("")

// 服务器清单
webHosts = ["web01", "web02", "web03"]

// 1. 串行执行
print("--- 串行执行 ---")
results = fleet.serial(webHosts, fn(h) => "checked " + h)
for r in results
    h = r["host"]
    ok = r["ok"]
    print("  " + h + ": ok=" + str(ok))

// 2. 并行执行
print("")
print("--- 并行执行 ---")
results = fleet.parallel(webHosts, fn(h) => "deployed " + h)
for r in results
    h = r["host"]
    ok = r["ok"]
    print("  " + h + ": ok=" + str(ok))

// 3. 结果汇总
print("")
print("--- 结果汇总 ---")
summary = fleet.summary(results)
t = summary["total"]
o = summary["ok"]
f = summary["fail"]
print("  总计: " + str(t))
print("  成功: " + str(o))
print("  失败: " + str(f))

print("")
print("Fleet 演示完成")
