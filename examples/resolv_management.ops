// resolv_management.ops - 演示 DNS 解析器配置管理
// 新增 SDK: resolv.*
privilege: admin

print("=== DNS 解析器配置管理 ===")

// 1. 获取当前 DNS 配置
print("\n当前 DNS 配置:")
let config = resolv.get()
print("  Nameservers:")
for ns in config.config.nameservers {
    print("    " + ns)
}
if len(config.config.search) > 0 {
    print("  Search domains:")
    for domain in config.config.search {
        print("    " + domain)
    }
}
if config.config.domain != "" {
    print("  Domain: " + config.config.domain)
}

// 2. 变更操作说明（DNS 改动影响解析链路，本示例不执行，也不假装执行）
print("\n变更操作（本示例不执行 — 会真实改写 /etc/resolv.conf）:")
print("  resolv.set(nameservers, search, options, domain)  整体重写解析配置")
print("  resolv.add_nameserver(ip) / remove_nameserver(ip) 增删单个 NS")
print("\n修改 DNS 配置可能影响网络解析，建议先备份当前配置。")
print("用法与返回值详见 docs/stdlib-reference.md")

print("\n注意：修改 DNS 配置可能影响网络解析")
print("建议先备份当前配置")

print("\n=== resolv 管理演示完成 ===")
