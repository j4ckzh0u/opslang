// nginx_check.ops - 批量检查 Nginx 配置合规性

// 声明式定义合规标准
nginx_compliance = {
    worker_processes: "auto",
    keepalive_timeout: 65,
    client_max_body_size: "10m",
    server_tokens: "off",
    gzip: "on",
    ssl_protocols: "TLSv1.2 TLSv1.3",
}

// 服务器清单
web_servers = [
    "10.0.0.1",
    "10.0.0.2",
    "10.0.0.3",
    "10.0.0.4",
    "10.0.0.5",
]

// 单台检查函数
fn check_nginx(host) {
    print("检查 {host} ...")

    // 连接检查
    if !ssh.ping(host) {
        return {host: host, status: "UNREACHABLE"}
    }

    // 获取配置
    config = ssh.run(host, "cat /etc/nginx/nginx.conf")
    if config.exitCode != 0 {
        return {host: host, status: "NO_NGINX"}
    }

    // 解析配置
    parsed = nginx.parse(config.stdout)
    issues = []

    // 逐项检查
    if parsed.worker_processes != "auto" {
        issues.append("worker_processes={parsed.worker_processes}")
    }
    if parsed.server_tokens != "off" {
        issues.append("server_tokens={parsed.server_tokens}")
    }
    if parsed.keepalive_timeout > 120 {
        issues.append("keepalive_timeout={parsed.keepalive_timeout}")
    }

    return {
        host: host,
        status: len(issues) == 0 ? "PASS" : "FAIL",
        issues: issues,
    }
}

// 批量并行检查
print("开始批量检查 {len(web_servers)} 台服务器...")
print("")

results = fleet.parallel(web_servers, parallel=10, fn(host) {
    return check_nginx(host)
})

// 生成报告
pass_count = 0
fail_count = 0
error_count = 0

for r in results {
    if r.status == "PASS" {
        pass_count += 1
    } else if r.status == "FAIL" {
        fail_count += 1
        print("FAIL: {r.host}")
        for issue in r.issues {
            print("  - {issue}")
        }
    } else {
        error_count += 1
        print("ERROR: {r.host} - {r.status}")
    }
}

print("")
print("=" * 50)
print("检查完成:")
print("  通过: {pass_count}")
print("  失败: {fail_count}")
print("  错误: {error_count}")

// 失败的自动修复（需要确认）
if fail_count > 0 {
    print("")
    if confirm("是否自动修复 {fail_count} 台不合规服务器？") {
        for r in results {
            if r.status == "FAIL" {
                print("修复 {r.host} ...")
                // 实际修复逻辑
                ssh.run(r.host, "nginx -t && nginx -s reload")
                print("  ✓ 已修复")
            }
        }
    }
}
