// yum_repo_management.ops - 演示 YUM/DNF 仓库管理
// 新增 SDK: yum_repo.*
privilege: admin

print("=== YUM/DNF 仓库管理 ===")

// 1. 列出当前仓库
print("\n当前 YUM 仓库:")
block {
    let repos = yum_repo.list()
    if len(repos.repos) == 0 {
        print("  (无 YUM 仓库配置 - 可能在非 RHEL/CentOS 系统上)")
    } else {
        for repo in repos.repos {
            let status = "禁用"
            if repo.enabled {
                status = "启用"
            }
            print("  [" + status + "] " + repo.id + " - " + repo.name)
            print("    URL: " + repo.base_url)
        }
    }
}
rescue {
    print("  ✗ 无法读取 YUM 仓库配置（需要 Linux 系统）")
}

// 2. 检查仓库是否存在
print("\n检查仓库是否存在:")
block {
    let exists = yum_repo.exists("epel")
    if exists.exists {
        print("  ✓ EPEL 仓库已配置")
    } else {
        print("  ✗ EPEL 仓库未配置")
    }
}
rescue {
    print("  ✗ 无法检查仓库（需要 Linux 系统）")
}

// 3. 演示添加仓库（不实际执行，避免副作用）
print("\n添加仓库示例（伪代码）:")
print(`
  yum_repo.add(
      "myrepo",
      "My Custom Repository",
      "https://repo.example.com/centos/$releasever/os/$basearch/",
      true,
      "https://repo.example.com/RPM-GPG-KEY-myrepo"
  )
`)

// 4. 演示移除仓库
print("\n移除仓库示例（伪代码）:")
print(`
  yum_repo.remove("myrepo")
`)

print("\n=== yum_repo 管理演示完成 ===")
