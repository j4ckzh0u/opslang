// ini_file_management.ops - 演示 INI 配置文件管理
// 新增 SDK: ini_file.*
privilege: admin

print("=== INI 配置文件管理 ===")

// 1. 列出配置文件的 sections
print("\n/etc/mysql/my.cnf 的 sections（如果存在）:")
block {
    let sections = ini_file.sections("/etc/mysql/my.cnf")
    if len(sections.sections) == 0 {
        print("  (无 sections 或文件不存在)")
    } else {
        for s in sections.sections {
            print("  [" + s + "]")
        }
    }
}
rescue {
    print("  ✗ 无法读取配置文件")
}

// 2. 获取配置值
print("\n获取 [mysqld] 部分的 port 配置:")
block {
    let value = ini_file.get("/etc/mysql/my.cnf", "mysqld", "port")
    if value.exists {
        print("  port = " + value.value)
    } else {
        print("  (配置不存在)")
    }
}
rescue {
    print("  ✗ 无法获取配置")
}

// 3. 真实写入配置（在 /tmp 下操作真实文件，非伪代码）
print("\n真实写入演示（/tmp/opslang-ini-demo/my.cnf）:")
let demo_conf = "/tmp/opslang-ini-demo/my.cnf"
file.ensure("/tmp/opslang-ini-demo", "directory", "0755")
file.ensure(demo_conf, "touch", "0644")

let s1 = ini_file.set(demo_conf, "mysqld", "max_connections", "500")
let s2 = ini_file.set(demo_conf, "mysqld", "innodb_buffer_pool_size", "2G")
print("  set max_connections: changed=" + str(s1.changed))
print("  set innodb_buffer_pool_size: changed=" + str(s2.changed))

// 读回验证（真实读取，不是相信写入的返回值）
let check = ini_file.get(demo_conf, "mysqld", "max_connections")
if !check.exists || check.value != "500" {
    alert("ini_file.set 写入后读回不一致")
} else {
    print("  读回验证: max_connections=" + check.value)
}

// 4. 真实删除配置
let rm1 = ini_file.remove(demo_conf, "mysqld", "max_connections")
let rm2 = ini_file.remove_section(demo_conf, "mysqld")
print("\n真实删除演示:")
print("  remove max_connections: changed=" + str(rm1.changed))
print("  remove_section mysqld: changed=" + str(rm2.changed))

// 清理演示文件
file.ensure("/tmp/opslang-ini-demo", "absent", "")

print("\nINI 文件管理适用于:")
print("  - MySQL/MariaDB 配置")
print("  - PostgreSQL 配置")
print("  - 传统的 Unix 配置文件")

print("\n=== ini_file 管理演示完成 ===")
