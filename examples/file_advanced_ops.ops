// 示例：使用新增的文件高级操作能力
// 演示 file.find / file.replace / file.blockinfile / file.ini_set / file.ini_get
privilege: admin

// 1. 查找 /tmp 下所有 .log 文件
let logs = file.find(["/tmp"], ["*.log"], "", "file", 3, 0, 0)
report { found_logs: logs.matched }

// 2. 正则替换文件内容
file.write("/tmp/demo_replace.txt", "hello world\nfoo bar\nhello again\n")
let replaced = file.replace("/tmp/demo_replace.txt", "hello", "goodbye", "", "")
report { replacements: replaced.replacements }

// 3. 在文件中插入/更新一个文本块
file.write("/tmp/demo_block.conf", "# config\n")
file.blockinfile(
    "/tmp/demo_block.conf",
    "# BEGIN MANAGED BLOCK",
    "key1=value1\nkey2=value2",
    true,   // present
    "",     // insert_after
    ""      // insert_before
)

// 4. INI 文件读写
file.write("/tmp/demo.ini", "[database]\nhost = localhost\nport = 3306\n")
file.ini_set("/tmp/demo.ini", "database", "password", "secret123")
let val = file.ini_get("/tmp/demo.ini", "database", "password")
report { ini_value: val.value, found: val.found }
