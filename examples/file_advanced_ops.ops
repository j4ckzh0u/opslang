// 示例：使用新增的文件高级操作能力
// 演示 file.find / file.replace / file.blockinfile / file.ini_set / file.ini_get
privilege: admin

// 1. 在固定的小目录内查找 .log 文件，避免扫描宿主机的整个 /tmp
let demo_dir = "/tmp/opslang-file-advanced"
file.mkdir(demo_dir)
file.write(demo_dir + "/app.log", "ready\n")
let logs = file.find([demo_dir], ["*.log"], "", "file", 3, 0, 0)
report { found_logs: logs.matched }

// 2. 正则替换文件内容
let replace_path = demo_dir + "/demo_replace.txt"
file.write(replace_path, "hello world\nfoo bar\nhello again\n")
let replaced = file.replace(replace_path, "hello", "goodbye", "", "")
report { replacements: replaced.replacements }

// 3. 在文件中插入/更新一个文本块
let block_path = demo_dir + "/demo_block.conf"
file.write(block_path, "# config\n")
file.blockinfile(
    block_path,
    "# BEGIN MANAGED BLOCK",
    "key1=value1\nkey2=value2",
    true,   // present
    "",     // insert_after
    ""      // insert_before
)

// 4. INI 文件读写
let ini_path = demo_dir + "/demo.ini"
file.write(ini_path, "[database]\nhost = localhost\nport = 3306\n")
file.ini_set(ini_path, "database", "password", "secret123")
let val = file.ini_get(ini_path, "database", "password")
report { ini_value: val.value, found: val.found }
