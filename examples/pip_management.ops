// pip_management.ops - 演示 Python 包管理
// 新增 SDK: pip.*
privilege: read_only

print("=== Python 包管理 ===")

// 1. 列出已安装的 Python 包
print("\n已安装的 Python 包:")
let packages = pip.list()
print("  状态: " + packages.status)

// 2. 检查特定包是否存在
print("\n检查 pip 包信息:")
let exists = pip.exists("pip")
print("  状态: " + exists.status)

print("\n=== pip 管理演示完成 ===")
