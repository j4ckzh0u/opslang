// 远程任务示例 —— 用 opsctl deploy 执行（opsctl run 会拒绝带 on 目标的 task）
//
//   opsctl deploy --inventory hosts.yaml examples/remote_task.ops
//
// task 的 on 子句按主机名/模式路由：web-* 的机器采集 CPU，db-* 的机器检查磁盘。
// 任务体必须是线性语句（调用/let/report）；需要 if/循环/ensure 时 deploy 会
// 自动改用 AOT 模式（编译为完整二进制）。

task "web_cpu_check" on "web-*" {
    let cpu = sys.cpu.usage()
    let load = sys.load()
    report { host_role: "web", cpu_percent: cpu.percent, load_1m: load.load1 }
}

task "db_disk_check" on "db-*" {
    let disk = sys.disk.usage("/var/lib")
    report { host_role: "db", disk_percent: disk.used_percent }
}
