// ufw_management.ops - 演示 Ubuntu 防火墙管理
// 新增 SDK: ufw.*
privilege: admin

print("=== Ubuntu 防火墙管理 ===")

// 1. 获取 UFW 状态
print("\n当前 UFW 状态:")
block {
    let status = ufw.status()
    print("  状态: " + status.status)
    print("  日志: " + status.logging)
}
rescue {
    print("  ✗ 无法获取 UFW 状态（可能未安装 UFW）")
}

// 2. 列出规则
print("\n当前规则:")
block {
    let rules = ufw.list()
    if len(rules.rules) == 0 {
        print("  (无规则)")
    } else {
        let count = 0
        let total = len(rules.rules)
        while count < total && count < 10 {
            let r = rules.rules[count]
            print("  " + r.action + " " + r.to + " from " + r.from)
            count = count + 1
        }
        if total > 10 {
            print("  ... 共 " + str(total) + " 条规则")
        }
    }
}
rescue {
    print("  ✗ 无法列出规则")
}

// 3. 真实服务收敛：ufw 已安装且具备管理权限时，确保服务可用并放行 SSH
//    （幂等：已满足则零动作）；否则显式跳过，绝不打印假成功
print("\n真实收敛演示（ufw 服务确保运行 + 放行 22/tcp）:")
let ufw_loaded = false
block {
    let st = service.status("ufw")
    if st.load_state == "loaded" {
        ufw_loaded = true
    }
}
rescue {
    // systemd 不可用或单元不存在
}

if !ufw_loaded {
    print("  SKIP: 本机未安装 ufw 单元（UFW 仅在 Ubuntu/Debian 可用）")
} else {
    block {
        // /run 仅 root 可写：探测真实管理权限
        file.ensure("/run/opslang-root-probe", "touch", "")
        file.ensure("/run/opslang-root-probe", "absent", "")

        let boot = service.ensure_enabled("ufw", true)
        print("  ensure_enabled(ufw, true): changed=" + str(boot.changed) + " actions=" + str(boot.actions))

        // 先保证 SSH 不会被后续防火墙规则锁在外面（运维铁律）
        let allow_ssh = ufw.allow("22", "tcp")
        print("  ufw.allow(22/tcp):         changed=" + str(allow_ssh.changed))
    }
    rescue {
        print("  SKIP: 管理 ufw 需要 root — " + _error)
    }
}

print("\n注意：UFW 仅在 Ubuntu/Debian 系统上可用")
print("对于 RHEL/CentOS，请使用 firewalld")

print("\n=== ufw 管理演示完成 ===")
