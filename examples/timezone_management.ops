// timezone_management.ops - 演示时区管理
// 新增 SDK: timezone.*
privilege: admin

print("=== 时区管理 ===")

// 1. 获取当前时区
print("\n当前时区:")
block {
    let tz = timezone.get()
    print("  " + tz.timezone)
}
rescue {
    print("  ✗ 无法获取时区")
}

// 2. 列出可用时区（前 10 个）
print("\n可用时区（前 10 个）:")
block {
    let zones = timezone.list()
    let count = 0
    let total = len(zones.zones)
    while count < total && count < 10 {
        print("  " + zones.zones[count])
        count = count + 1
    }
    if total > 10 {
        print("  ... 共 " + str(total) + " 个时区")
    }
}
rescue {
    print("  ✗ 无法列出时区")
}

// 3. 演示设置时区（伪代码）
print("\n设置时区示例（伪代码）:")
print(`
  timezone.set("Asia/Shanghai")
  timezone.set("America/New_York")
  timezone.set("Europe/London")
  timezone.set("UTC")
`)

print("\n注意：")
print("  - 设置时区需要 root 权限")
print("  - 使用 systemd 的系统通过 timedatectl 设置")
print("  - 其他系统通过更新 /etc/localtime 和 /etc/timezone")

print("\n=== timezone 管理演示完成 ===")
