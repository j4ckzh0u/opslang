// timezone_management.ops - 演示时区管理
// 新增 SDK: timezone.*
privilege: admin

print("=== 时区管理 ===")

// 1. 获取当前时区
print("\n当前时区:")
block {
    let tz = timezone.get()
    print("  " + tz.timezone)
}
rescue {
    print("  ✗ 无法获取时区")
}

// 2. 列出可用时区（前 10 个）
print("\n可用时区（前 10 个）:")
block {
    let zones = timezone.list()
    let count = 0
    let total = len(zones.zones)
    while count < total && count < 10 {
        print("  " + zones.zones[count])
        count = count + 1
    }
    if total > 10 {
        print("  ... 共 " + str(total) + " 个时区")
    }
}
rescue {
    print("  ✗ 无法列出时区")
}

// 3. 变更操作说明（改时区影响日志与定时任务语义，本示例不执行）
print("\n变更操作（本示例不执行 — 会真实修改系统时区）:")
print("  timezone.set(tz)   例如 timezone.set(\"Asia/Shanghai\")")
print("\n设置时区需要 root 权限：systemd 系统通过 timedatectl，")
print("其他系统通过更新 /etc/localtime 与 /etc/timezone 完成。")
print("用法与返回值详见 docs/stdlib-reference.md")

print("\n注意：")
print("  - 设置时区需要 root 权限")
print("  - 使用 systemd 的系统通过 timedatectl 设置")
print("  - 其他系统通过更新 /etc/localtime 和 /etc/timezone")

print("\n=== timezone 管理演示完成 ===")
