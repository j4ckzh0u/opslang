// logrotate_management.ops - 演示日志轮转配置管理
// 新增 SDK: logrotate.*
privilege: admin

print("=== 日志轮转配置管理 ===")

// 1. 列出当前日志轮转配置
print("\n当前日志轮转配置:")
block {
    let configs = logrotate.list()
    if len(configs.configs) == 0 {
        print("  (无日志轮转配置)")
    } else {
        let count = 0
        let total = len(configs.configs)
        let i = 0
        while i < total && count < 10 {
            let c = configs.configs[i]
            print("  " + c.name + ": " + c.pattern + " (" + c.frequency + ", rotate " + str(c.rotate) + ")")
            count = count + 1
            i = i + 1
        }
        if total > 10 {
            print("  ... 共 " + str(total) + " 个配置")
        }
    }
}
rescue {
    print("  ✗ 无法读取日志轮转配置（需要 Linux 系统）")
}

// 2. 获取特定配置
print("\n获取 nginx 日志轮转配置:")
block {
    let config = logrotate.get("nginx")
    print("  模式: " + config.config.pattern)
    print("  频率: " + config.config.frequency)
    print("  保留: " + str(config.config.rotate) + " 份")
}
rescue {
    print("  ✗ nginx 日志轮转配置未找到或不可用")
}

// 3. 真实设置/移除日志轮转（需要 Linux + root；不满足则显式跳过）
print("\n真实写入演示（/etc/logrotate.d/opslang-demo，结束后清理）:")
let can_write = false
block {
    // /run 仅 root 可写：探测真实写权限
    file.ensure("/run/opslang-root-probe", "touch", "")
    file.ensure("/run/opslang-root-probe", "absent", "")
    can_write = true
}
rescue {
    print("  SKIP: 写入 /etc/logrotate.d 需要 root — " + _error)
}

if can_write {
    block {
        let set_r = logrotate.set("opslang-demo", "/var/log/opslang-demo/*.log", "daily", 7, true, "")
        print("  logrotate.set: changed=" + str(set_r.changed) + " name=" + set_r.name)

        // 从磁盘读回验证（真实读取）
        let verify = logrotate.get("opslang-demo")
        print("  读回验证: pattern=" + verify.config.pattern + " frequency=" + verify.config.frequency)

        // 幂等复跑：已存在时 Changed=false 才对
        let set_again = logrotate.set("opslang-demo", "/var/log/opslang-demo/*.log", "daily", 7, true, "")
        print("  复跑: changed=" + str(set_again.changed))

        // 清理，不留配置残留
        let rm = logrotate.remove("opslang-demo")
        print("  logrotate.remove: changed=" + str(rm.changed) + " name=" + rm.name)
    }
    rescue {
        // 即使中途失败也尝试清理
        block { logrotate.remove("opslang-demo") }
        rescue { }
        print("  ✗ 操作失败: " + _error)
    }
}

print("\n=== logrotate 管理演示完成 ===")
