// disk_check.ops - Check disk usage across all mounted partitions
// Demonstrates: sys.disk.usage(), sys.disk.partitions(), alerting, structured report
// Works on both macOS and Linux
// Usage: opsctl run examples/disk_check.ops

print("=== Disk Usage Check ===")

// Get all mounted partitions
let partitions = sys.disk.partitions()
let hostname = sys.hostname()

print("Host: " + hostname.hostname)
print("Checking " + str(len(partitions)) + " partitions...")
print("")

let warn_threshold = 80
let alert_threshold = 90
let warn_count = 0
let alert_count = 0
let ok_count = 0

// Check each partition's disk usage
for let i = 0; i < len(partitions); i = i + 1 {
    let part = partitions[i]
    let mount = part.mountpoint
    let device = part.device

    // Get usage for this mount point
    let usage = sys.disk.usage(mount)
    let pct = usage.used_percent
    let total_gb = usage.total / 1073741824
    let used_gb = usage.used / 1073741824
    let free_gb = usage.free / 1073741824

    // Determine status based on thresholds
    let status = "OK"
    if pct >= alert_threshold {
        status = "CRITICAL"
        alert("Disk " + mount + " is " + str(int(pct)) + "% full (" + str(int(used_gb)) + "GB / " + str(int(total_gb)) + "GB)")
        alert_count = alert_count + 1
    } else if pct >= warn_threshold {
        status = "WARNING"
        print("WARNING: " + mount + " is " + str(int(pct)) + "% full (" + str(int(used_gb)) + "GB / " + str(int(total_gb)) + "GB)")
        warn_count = warn_count + 1
    } else {
        ok_count = ok_count + 1
    }

    // Print status line
    print("  " + mount + " (" + device + "): " + str(int(pct)) + "% used [" + status + "] - " + str(int(free_gb)) + "GB free")
}

print("")
print("Summary: " + str(ok_count) + " OK, " + str(warn_count) + " warnings, " + str(alert_count) + " critical")

// Structured report
report {
    host: hostname.hostname,
    partition_count: len(partitions),
    ok_count: ok_count,
    warn_count: warn_count,
    alert_count: alert_count,
    threshold_warn: warn_threshold,
    threshold_alert: alert_threshold
}

log("Disk check completed: " + str(len(partitions)) + " partitions scanned")
