// ensure_service.ops - Ensure pattern for service health (cross-platform)
// Demonstrates: ensure statement, file operations as service proxy
//
// NOTE: On Linux with systemd, you would use service.status(), service.start(), etc.
// This example uses file-based ensure patterns that work on both macOS and Linux.
//
// For Linux-only service management, you could write:
//   ensure service.status("nginx").running {
//       service.start("nginx")
//   }
//
// Usage: opsctl run examples/ensure_service.ops

privilege: admin
print("=== Service Health Check (Cross-Platform) ===")

let hostname = sys.hostname()
print("Host: " + hostname.hostname)

// Simulate a "service" using a PID file and config file pattern
// Real services write PID files; we replicate this pattern
let pid_dir = "/tmp/ops-example-service"
let pid_file = pid_dir + "/myapp.pid"
let config_file = pid_dir + "/myapp.conf"
let log_file = pid_dir + "/myapp.log"

// Step 1: Ensure the service directory exists
print("")
print("--- Step 1: Ensure directory exists ---")
ensure file.exists(pid_dir).exists {
    print("Creating service directory: " + pid_dir)
    file.mkdir(pid_dir)
}
print("Directory ready: " + pid_dir)

// Step 2: Ensure config file exists with correct content
print("")
print("--- Step 2: Ensure config file ---")
ensure file.exists(config_file).exists {
    print("Creating config file: " + config_file)
    file.write(config_file, "workers=4\ntimeout=30\nlog_level=info\nport=8080\n")
}
let cfg = file.read(config_file)
print("Config ready (" + str(cfg.size) + " bytes)")

// Step 3: Ensure PID file exists (simulate a running service)
print("")
print("--- Step 3: Ensure PID file (simulate running service) ---")
ensure file.exists(pid_file).exists {
    print("Creating PID file (simulating service start)")
    let now = time.now()
    file.write(pid_file, str(now.unix))
}
let pid_content = file.read(pid_file)
print("PID file ready, value: " + pid_content.content)

// Step 4: Verify service health (check all files exist)
print("")
print("--- Step 4: Health verification ---")
let pid_ok = file.exists(pid_file)
let cfg_ok = file.exists(config_file)
let dir_ok = file.exists(pid_dir)

let all_healthy = true
print("  Directory exists: " + str(dir_ok.exists))
print("  Config exists: " + str(cfg_ok.exists))
print("  PID file exists: " + str(pid_ok.exists))

if !dir_ok.exists {
    all_healthy = false
    alert("Service directory missing!")
}
if !cfg_ok.exists {
    all_healthy = false
    alert("Config file missing!")
}
if !pid_ok.exists {
    all_healthy = false
    alert("PID file missing - service not running!")
}

if all_healthy {
    print("Service status: HEALTHY")
} else {
    print("Service status: UNHEALTHY")
    alert("Service health check failed!")
}

// Step 5: Check the actual system for a real process
print("")
print("--- Step 5: Check real system process ---")
let init_procs = process.find_by_name("launchd")
if len(init_procs) == 0 {
    let init_procs = process.find_by_name("systemd")
}
if len(init_procs) > 0 {
    let init_p = init_procs[0]
    print("  Init system process: " + init_p.name + " (PID " + str(init_p.pid) + ")")
} else {
    print("  No init system process found")
}

report {
    host: hostname.hostname,
    service: "myapp",
    healthy: all_healthy,
    dir_exists: dir_ok.exists,
    config_exists: cfg_ok.exists,
    pid_exists: pid_ok.exists,
    platform: sys.os().os
}

// Cleanup
file.delete(pid_file)
file.delete(config_file)
file.delete(log_file)
file.delete(pid_dir)

log("Service health check completed")
