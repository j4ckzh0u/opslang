// functions.ops - User-defined functions wrapping real SDK calls
// Usage: opsctl run examples/functions.ops
// Demonstrates: simple functions, return values, default parameters,
// recursion, and using functions to wrap SDK operations

print("=== Functions Demo ===")

// Simple function: get system summary from SDK
fn system_summary() {
    let h = sys.hostname()
    let c = sys.cpu.count()
    return h.hostname + " (" + str(c.logical) + " cores)"
}

print("System: " + system_summary())

// Function with return value: get memory usage in MB
fn memory_used_mb() {
    let mem = sys.memory.info()
    return mem.used / 1024 / 1024
}

let used = memory_used_mb()
print("Memory used: " + str(used) + " MB")

// Function with default parameter: disk usage for any path
fn disk_usage_percent(path = "/") {
    let d = sys.disk.usage(path)
    return d.used_percent
}

print("Root disk usage: " + str(disk_usage_percent()) + "%")
print("/tmp disk usage: " + str(disk_usage_percent("/tmp")) + "%")

// Recursive function: compute factorial
fn factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

let cores = sys.cpu.count()
let n = cores.logical
print("Factorial of " + str(n) + " cores: " + str(factorial(n)))

// Higher-order pattern: function that takes a getter function
fn report_value(label, getter_fn) {
    let val = getter_fn()
    print(label + ": " + str(val))
    return val
}

// Use it with a wrapper function
fn get_load() {
    let l = sys.load()
    return l.load1
}

let load1 = report_value("Load 1m", get_load)

report {
    system: system_summary(),
    memory_used_mb: used,
    root_disk_percent: disk_usage_percent(),
    factorial_cores: factorial(n),
    load_1m: load1
}
