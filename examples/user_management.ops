// user_management.ops - 演示用户和用户组管理
// 新增 SDK: user.*, group.*
privilege: admin

print("=== 查询系统用户 ===")

// 列出所有用户
let users = user.list()
print("系统用户总数: " + str(len(users)))

// 查询特定用户信息
let root_info = user.info("root")
print("\nroot 用户信息:")
print("  UID: " + str(root_info.user.uid))
print("  GID: " + str(root_info.user.gid))
print("  Home: " + root_info.user.home)
print("  Shell: " + root_info.user.shell)

// 检查用户是否存在
let exists = user.exists("root")
print("\nroot 用户存在: " + str(exists.exists))

// ═══════════════════════════════════════════════════════════
// 2. 用户组管理
// ═══════════════════════════════════════════════════════════

print("\n=== 用户组管理 ===")

// 列出所有用户组
let groups = group.list()
print("系统用户组总数: " + str(len(groups)))

// 检查组是否存在
let group_exists = group.exists("staff")
print("staff 组存在: " + str(group_exists.exists))

// ═══════════════════════════════════════════════════════════
// 3. 批量用户查询
// ═══════════════════════════════════════════════════════════

print("\n=== 批量用户查询 ===")

let user_list = ["root", "nobody"]

for username in user_list {
    let check = user.exists(username)
    if check.exists {
        let info = user.info(username)
        print(username + ": UID=" + str(info.user.uid) + ", Shell=" + info.user.shell)
    } else {
        print(username + ": 不存在")
    }
}

print("\n=== 用户管理演示完成 ===")
