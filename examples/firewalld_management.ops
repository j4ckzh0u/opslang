// firewalld_management.ops - 演示 firewalld 防火墙服务管理
// 新增 SDK: firewalld.*
privilege: admin

print("=== firewalld 防火墙服务管理 ===")

// 1. 获取 firewalld 状态
print("\nfirewalld 状态:")
block {
    let status = firewalld.get()
    print("  运行中: " + str(status.status.running))
    print("  开机启动: " + str(status.status.enabled))
    if status.status.default_zone != "" {
        print("  默认区域: " + status.status.default_zone)
    }
}
rescue {
    print("  ✗ firewalld 不可用（可能在非 Linux 系统或未安装）")
}

// 2. 列出可用区域
print("\n可用区域:")
block {
    let zones = firewalld.list_zones()
    if len(zones.zones) == 0 {
        print("  (无区域信息)")
    } else {
        for z in zones.zones {
            print("  - " + z)
        }
    }
}
rescue {
    print("  ✗ 无法获取区域信息")
}

// 3. 真实服务收敛：firewalld 已安装且当前用户可管理系统时，收敛为
//    started + enabled（幂等：已满足则零动作）；否则显式跳过
print("\n真实收敛演示（service.ensure firewalld → started+enabled）:")
let fw_loaded = false
block {
    let st = service.status("firewalld")
    if st.load_state == "loaded" {
        fw_loaded = true
    }
}
rescue {
    // systemd 不可用或单元不存在
}

if !fw_loaded {
    print("  SKIP: 本机未安装 firewalld 单元，无可收敛对象")
} else {
    block {
        // /run 仅 root 可写：探测真实管理权限
        file.ensure("/run/opslang-root-probe", "touch", "")
        file.ensure("/run/opslang-root-probe", "absent", "")

        let run = service.ensure("firewalld", "started")
        let boot = service.ensure_enabled("firewalld", true)
        print("  ensure(started):       changed=" + str(run.changed) + " actions=" + str(run.actions))
        print("  ensure_enabled(true):  changed=" + str(boot.changed) + " actions=" + str(boot.actions))
    }
    rescue {
        print("  SKIP: 收敛 firewalld 需要 root — " + _error)
    }
}

print("\n=== firewalld 管理演示完成 ===")
