// hello.ops - OpsLang 示例：Hello World

// 1. 基础输出
print("Hello, OpsLang!")

// 2. 变量和字符串插值
name = "运维工程师"
print("你好，{name}！")

// 3. 数字运算
cpu_count = 8
memory_gb = 32
print("服务器配置: {cpu_count}核 {memory_gb}GB")

// 4. 数组和循环
hosts = ["web01", "web02", "web03"]
print("共有 {len(hosts)} 台服务器:")
for host in hosts {
    print("  - {host}")
}

// 5. 条件判断
for host in hosts {
    if host == "web01" {
        print("{host} 是主服务器")
    } else {
        print("{host} 是从服务器")
    }
}

// 6. 函数定义
fn check_disk(host, threshold = 80) {
    // 模拟检查磁盘使用率
    usage = 75  // 实际应该是: ssh.run(host, "df -h /")
    if usage > threshold {
        print("警告: {host} 磁盘使用率 {usage}%")
    } else {
        print("正常: {host} 磁盘使用率 {usage}%")
    }
}

for host in hosts {
    check_disk(host)
}
