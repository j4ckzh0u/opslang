// hello.ops - OpsLang 入门示例

// 变量和输出
name = "OpsLang"
print("Hello, {name}!")

// 数组和循环
hosts = ["web01", "web02", "web03"]
print("服务器列表:")
for host in hosts
    print("  - {host}")

// 函数定义
fn check_disk(host, threshold)
    // 模拟磁盘检查
    usage = 75
    if usage > threshold
        print("警告: {host} 磁盘使用率 {usage}%")
    else
        print("正常: {host} 磁盘使用率 {usage}%")

for host in hosts
    check_disk(host, 80)

// 条件判断
count = 5
if count > 3
    print("服务器数量充足")
else
    print("服务器数量不足")

print("示例运行完成!")
