// block_rescue_example.ops - 演示 block/rescue/always 错误处理
// 类似 Ansible 的错误处理机制
privilege: admin

// ═══════════════════════════════════════════════════════════
// 1. 基本 block/rescue 用法
// ═══════════════════════════════════════════════════════════

print("=== 示例 1: 基本错误处理 ===")

block {
    print("尝试执行操作...")
    // 模拟可能失败的操作
    let result = file.read("/nonexistent/file.txt")
    print("读取成功: " + result.content)
}
rescue {
    print("操作失败，进入 rescue 块")
    print("错误信息: " + _error)
    // 这里可以执行恢复操作
}
always {
    print("无论成功失败，都会执行 always 块")
    print("清理临时资源...")
}

// ═══════════════════════════════════════════════════════════
// 2. 服务管理中的错误处理
// ═══════════════════════════════════════════════════════════

print("\n=== 示例 2: 服务重启 ===")

block {
    print("重启 nginx 服务...")
    service.restart("nginx")
    print("服务重启成功")
}
rescue {
    print("服务重启失败: " + _error)
    print("这是预期的，因为示例环境可能没有 nginx 或 systemctl")
}

// ═══════════════════════════════════════════════════════════
// 3. 部署场景中的错误处理
// ═══════════════════════════════════════════════════════════

print("\n=== 示例 3: 应用部署 ===")

let deploy_backup_path = "/tmp/app_backup_" + str(time.now().unix)

block {
    print("步骤 1: 备份当前版本...")
    let backup = file.copy("/opt/app/current", deploy_backup_path)
    print("  ✓ 备份完成")

    print("\n步骤 2: 部署新版本...")
    // 假设这里有部署逻辑
    file.write("/opt/app/current/version.txt", "v2.0.0")
    print("  ✓ 部署完成")

    print("\n步骤 3: 重启服务...")
    service.restart("myapp")
    print("  ✓ 服务重启完成")

    print("\n部署成功!")
}
rescue {
    print("部署失败，执行回滚: " + _error)

    // 回滚：恢复备份（如果备份存在）
    block {
        if file.exists(deploy_backup_path).exists {
            let rollback = file.copy(deploy_backup_path, "/opt/app/current")
            print("回滚完成")
        } else {
            print("备份文件不存在，跳过回滚")
        }
    }
    rescue {
        print("回滚也失败: " + _error)
    }
    // 尝试重启服务
    block {
        service.start("myapp")
    }
    rescue {
        print("服务重启失败（预期中）: " + _error)
    }
}
always {
    print("\n清理临时文件...")
    file.delete(deploy_backup_path)
}

// ═══════════════════════════════════════════════════════════
// 4. 嵌套 block/rescue
// ═══════════════════════════════════════════════════════════

print("\n=== 示例 4: 嵌套错误处理 ===")

block {
    print("外层操作开始...")

    block {
        print("  内层操作...")
        let result = file.read("/etc/shadow")  // 可能权限不足
        print("  内层成功")
    }
    rescue {
        print("  内层失败: " + _error)
        print("  尝试备用方案...")
    }

    print("外层继续...")
}
rescue {
    print("外层也失败: " + _error)
}

print("\n=== block/rescue/always 演示完成 ===")
