{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "OpsLang",
    "scopeName": "source.opslang",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#modules" },
        { "include": "#operators" },
        { "include": "#functions" },
        { "include": "#variables" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.opslang",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.opslang",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.triple.opslang",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.opslang",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.opslang",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.opslang",
                            "match": "\\\\."
                        },
                        {
                            "name": "variable.other.interpolation.opslang",
                            "begin": "\\{",
                            "end": "\\}",
                            "patterns": [
                                { "include": "$self" }
                            ]
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.opslang",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.opslang",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.opslang",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.opslang",
                    "match": "\\b\\d+\\b"
                },
                {
                    "name": "constant.numeric.hex.opslang",
                    "match": "\\b0x[0-9a-fA-F]+\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.opslang",
                    "match": "\\b(if|else|for|in|while|break|continue|return|try|catch|defer|import|as)\\b"
                },
                {
                    "name": "keyword.other.opslang",
                    "match": "\\b(fn|ensure|fleet)\\b"
                },
                {
                    "name": "constant.language.opslang",
                    "match": "\\b(true|false|nil)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.opslang",
                    "match": "\\b(print|len|type|str|int|range|append|map|filter|input)\\b"
                }
            ]
        },
        "modules": {
            "patterns": [
                {
                    "name": "support.module.opslang",
                    "match": "\\b(file|process|ssh|fleet|json|yaml|toml|strings|math|ensure|inventory)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.opslang",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.logical.opslang",
                    "match": "(&&|\\|\\||!)"
                },
                {
                    "name": "keyword.operator.arithmetic.opslang",
                    "match": "(\\+|-|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.assignment.opslang",
                    "match": "(=|\\+=|-=)"
                },
                {
                    "name": "keyword.operator.pipe.opslang",
                    "match": "\\|>"
                },
                {
                    "name": "keyword.operator.arrow.opslang",
                    "match": "=>"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.opslang",
                    "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
                    "captures": {
                        "2": { "name": "entity.name.function.opslang" }
                    }
                },
                {
                    "name": "entity.name.function.call.opslang",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.call.opslang" }
                    }
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.opslang",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}
