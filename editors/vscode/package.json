{
    "name": "opslang",
    "displayName": "OpsLang",
    "description": "OpsLang language support for VS Code",
    "version": "0.1.0",
    "publisher": "opslang",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": ["Programming Languages", "Snippets", "Linters"],
    "activationEvents": [
        "onLanguage:opslang",
        "workspaceContains:**/*.ops"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [{
            "id": "opslang",
            "aliases": ["OpsLang", "opslang", "ops"],
            "extensions": [".ops"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "opslang",
            "scopeName": "source.opslang",
            "path": "./syntaxes/opslang.tmLanguage.json"
        }],
        "snippets": [{
            "language": "opslang",
            "path": "./snippets/opslang.json"
        }],
        "configuration": {
            "title": "OpsLang",
            "properties": {
                "opslang.serverPath": {
                    "type": "string",
                    "default": "ops",
                    "description": "OpsLang 可执行文件路径"
                },
                "opslang.enableLSP": {
                    "type": "boolean",
                    "default": true,
                    "description": "启用 LSP 语言服务器"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "^1.75.0",
        "@types/node": "^18.0.0",
        "typescript": "^5.0.0"
    }
}
