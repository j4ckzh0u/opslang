# Binary names are anchored to the repo root: a bare "opsctl"/"ops-runner"
# pattern matches the cmd/opsctl and cmd/ops-runner DIRECTORIES too, which
# silently swallowed every new source file added there (lineeditor.go was
# lost this way, breaking CI builds).
/ops-runner
/output
.opslang-build/
*.swp
# Test environment (local only)
test_env/
*.test.env

# Tests directory - contains credentials and test data
tests/
*.log

# Build artifacts
bin/
dist/
coverage.out
/opsctl
